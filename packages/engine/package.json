{
  "name": "@webchess/engine",
  "version": "0.1.0",
  "private": true,
  "description": "内置中国象棋搜索引擎（alpha-beta + 置换表），纯 TypeScript，Web/小程序通用",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./wasm/engine-core.wasm": "./wasm/engine-core.wasm",
    "./wasm/nnue-weights.bin": "./wasm/nnue-weights.bin"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "build:wasm": "asc assembly/engine-core.ts -o wasm/engine-core.wasm --runtime stub -O3 --noAssert",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@webchess/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
